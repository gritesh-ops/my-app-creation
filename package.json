{
  "name": "teampilot-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TeamPilot AI - AI project planner and shared workspace for college group projects",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  }
}
